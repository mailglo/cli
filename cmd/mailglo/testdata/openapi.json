{
  "openapi": "3.0.3",
  "info": {
    "title": "Fixture API",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/domains": {
      "get": {
        "operationId": "ListDomains",
        "summary": "List domains.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "name": "status",
            "in": "query",
            "description": "Only domains in this state.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "operationId": "CreateDomain",
        "summary": "Add a domain.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Makes a retry safe.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewDomain"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/domains/{domainId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/DomainId"
        }
      ],
      "get": {
        "operationId": "GetDomain",
        "summary": "Show one domain.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "operationId": "DeleteDomain",
        "summary": "Remove a domain.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/domains/{domainId}/notes": {
      "parameters": [
        {
          "$ref": "#/components/parameters/DomainId"
        }
      ],
      "post": {
        "operationId": "AddNote",
        "summary": "Add a note to a domain.",
        "requestBody": {
          "$ref": "#/components/requestBodies/Text"
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "description": "Cursor for the next page.",
        "schema": {
          "type": "string"
        }
      },
      "DomainId": {
        "name": "domainId",
        "in": "path",
        "required": true,
        "description": "Domain identifier.",
        "schema": {
          "type": "string"
        }
      }
    },
    "requestBodies": {
      "Text": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Named": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "NewDomain": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Named"
          },
          {
            "type": "object",
            "properties": {
              "policy": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  }
}
